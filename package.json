{
  "name": "opencode-double-esc-timeline",
  "version": "1.0.1",
  "description": "Double-tap Escape in opencode to open the session timeline — the messages you sent. Claude Code's double-Esc message history, as an opencode plugin (no fork).",
  "type": "module",
  "license": "MIT",
  "author": "ZacxDev",
  "homepage": "https://github.com/ZacxDev/opencode-double-esc-timeline#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZacxDev/opencode-double-esc-timeline.git"
  },
  "bugs": {
    "url": "https://github.com/ZacxDev/opencode-double-esc-timeline/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui",
    "claude-code",
    "timeline",
    "rewind",
    "undo",
    "escape",
    "double-tap",
    "tui",
    "nix",
    "nix-flake"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node test/run.mjs",
    "prepublishOnly": "npm run test"
  },
  "engines": {
    "opencode": ">=2.0.0"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0 <3"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
